#!/bin/sh
set -eu

bootstrap=/run/coordplane/bootstrap
run_id=$(sed -n 's/^Run: //p' "$bootstrap")
kind=$(sed -n 's/^Kind: //p' "$bootstrap")
description=$(sed -n 's/^Description: //p' "$bootstrap")

echo "{\"type\":\"thread.started\",\"thread_id\":\"p5-$run_id\"}"
/usr/local/bin/coordlink progress --summary "P5-READY" --request-id "p5-ready-$run_id" --output json

inbox() {
	/usr/local/bin/coordlink inbox list --output human |
		tee /dev/stderr |
		sed '/^COORDPLANE_PERF_CLIENT /d'
}

wait_for_body() {
	wanted=$1
	attempt=0
	while [ "$attempt" -lt 600 ]; do
		messages=$(inbox)
		if printf '%s\n' "$messages" | grep -F "$wanted" >/dev/null 2>&1; then
			printf '%s\n' "$messages"
			return 0
		fi
		attempt=$((attempt + 1))
		sleep 0.05
	done
	echo "timed out waiting for inbox body: $wanted" >&2
	return 1
}

ack_all() {
	messages=$(inbox)
	set -- inbox ack
	for message_id in $(printf '%s\n' "$messages" | awk 'NF { print $1 }'); do
		set -- "$@" --ack-message "$message_id"
	done
	if [ "$#" -gt 2 ]; then
		/usr/local/bin/coordlink "$@" --request-id "p5-ack-$run_id" --output json
	fi
}

configure_git() {
	git config --global --add safe.directory /workspace/project
	git config user.name "CoordPlane P5 $1"
	git config user.email "p5-$1@coordplane.local"
}

if [ "$kind" = "conversation" ]; then
	wait_for_body "P5-DIRECT" >/dev/null
	wait_for_body "P5-BOOT" >/dev/null
	wait_for_body "P5-GO" >/dev/null
	ack_all
	/usr/local/bin/coordlink task wait --reason "P5 messages acknowledged after redelivery" \
			--request-id "p5-conversation-wait-$run_id" --output json
	sleep 30
elif [ "$kind" = "integration" ]; then
	configure_git integration
	source_head=$(sed -n 's/^Source head: //p' "$bootstrap")
	git merge --no-ff "$source_head" -m "P5 integrate stale source"
	./fixture-test.sh
	head=$(git rev-parse HEAD)
	/usr/local/bin/coordlink progress --summary "P5 integration tested" \
		--request-id "p5-integration-progress-$run_id" --output json
	/usr/local/bin/coordlink task submit --summary "P5 integration complete" --expected-head "$head" \
		--request-id "p5-integration-submit-$run_id" --output json
	sleep 30
else
	role=$(printf '%s\n' "$description" | sed -n 's/.*p5_role=\([ABCD]\).*/\1/p')
	[ -n "$role" ]
	configure_git "$role"
	go_message=$(wait_for_body "P5-GO")
	is_pf01=false
	if printf '%s\n' "$description" | grep -F 'pf01=true' >/dev/null 2>&1; then
		is_pf01=true
	fi
	progress_count=$(printf '%s\n' "$description" | sed -n 's/.*progress_count=\([0-9][0-9]*\).*/\1/p')
	progress_count=${progress_count:-1}
	progress_index=1
	while [ "$progress_index" -le "$progress_count" ]; do
		/usr/local/bin/coordlink progress --summary "P5-$role progress $progress_index" \
			--request-id "p5-progress-$role-$run_id-$progress_index" --output json
		progress_index=$((progress_index + 1))
	done
	if [ "$is_pf01" = true ]; then
		d_agent=$(printf '%s\n' "$go_message" | sed -n 's/.*d_agent=\([^ ]*\).*/\1/p' | head -1)
		d_task=$(printf '%s\n' "$go_message" | sed -n 's/.*d_task=\([^ ]*\).*/\1/p' | head -1)
		if [ "$role" != D ]; then
			case "$role" in A) peer_count=4 ;; B|C) peer_count=3 ;; esac
			peer_index=1
			while [ "$peer_index" -le "$peer_count" ]; do
				/usr/local/bin/coordlink message send --to-agent "$d_agent" --task "$d_task" \
					--body "PF01-PEER $role $peer_index" --request-id "pf01-peer-$run_id-$peer_index" --output json
				peer_index=$((peer_index + 1))
			done
			ack_all
		else
			attempt=0
			while [ "$attempt" -lt 600 ]; do
				messages=$(inbox)
				[ "$(printf '%s\n' "$messages" | grep -c 'PF01-PEER' || true)" -ge 10 ] && break
				attempt=$((attempt + 1))
				sleep 0.05
			done
			[ "$attempt" -lt 600 ]
			ack_all
		fi
		wave=$(printf '%s\n' "$go_message" | sed -n 's/.*wave=\([^ ]*\).*/\1/p' | head -1)
		[ -n "$wave" ]
		file="bench/$(printf '%s' "$role" | tr '[:upper:]' '[:lower:]').txt"
		printf 'wave-%s-agent-%s\n' "$wave" "$role" >"$file"
	else
		if [ "$role" = "A" ]; then
			peer_agent=$(printf '%s\n' "$description" | sed -n 's/.*peer_agent_id=\([^ ;]*\).*/\1/p')
			[ -n "$peer_agent" ]
			/usr/local/bin/coordlink message send --to-agent "$peer_agent" --wake \
				--body "P5-DIRECT from $run_id" --request-id "p5-direct-$run_id" --output json
			ack_all
		else
			wait_for_body "P5-DIRECT" >/dev/null
		fi
		file="agent-$role.txt"
		printf 'agent-%s\n' "$role" >"$file"
	fi
	./fixture-test.sh
	git add "$file"
	git commit -m "P5 Agent $role result"
	head=$(git rev-parse HEAD)
	if [ "$is_pf01" = false ]; then
		/usr/local/bin/coordlink progress --summary "P5-$role tested" \
			--request-id "p5-progress-$role-$run_id" --output json
	fi
	/usr/local/bin/coordlink task submit --summary "P5 Agent $role result" --expected-head "$head" \
		--request-id "p5-submit-$role-$run_id" --output json
	sleep 30
fi

echo '{"type":"turn.completed"}'
